# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/shahzad-portfolio

# Server port
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Secret used to sign admin JWTs — use a long random string in production
ADMIN_JWT_SECRET=change-this-to-a-long-random-string

# The single admin account checked by POST /api/admin/login.
# There is no signup and no user collection — change both before deploying.
# The values below are non-functional placeholders, never real credentials.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=change-this-to-a-long-random-password

